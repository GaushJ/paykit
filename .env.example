# Copy to .env and fill in. All vars are read with prefix PAYKIT_.

PAYKIT_PROVIDER=razorpay
PAYKIT_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
PAYKIT_RAZORPAY_KEY_SECRET=changeme
PAYKIT_RAZORPAY_WEBHOOK_SECRET=changeme

# Optional
# PAYKIT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/paykit
# PAYKIT_TABLE_PREFIX=paykit_
PAYKIT_DEFAULT_CURRENCY=INR
PAYKIT_HTTP_TIMEOUT_SECONDS=15

# Standalone service only
# PAYKIT_SERVICE_API_KEYS=key1,key2
# PAYKIT_OUTBOUND_WEBHOOK_URL=https://your-app.example.com/paykit/webhook
# PAYKIT_OUTBOUND_WEBHOOK_SECRET=changeme
